{
  "schema": "source-mapping.v1",
  "profileId": "sim-hvac-controller",
  "version": 1,
  "displayName": "HVAC Controller",
  "vendorLabel": "Synthetic HVAC vendor B (nested measurements with units)",
  "description": "Synthetic HVAC controller reporting the cold-storage zone and the backup cooling unit as nested measurements, each with its own unit. A demonstration profile, not a real vendor integration.",
  "sourceType": "SIMULATOR",
  "synthetic": true,
  "timestamp": { "path": "sampled", "format": "ISO_8601" },
  "asset": { "fixed": "AST-SIM-ZONE-1" },
  "fields": [
    {
      "signal": "temperature",
      "path": "zone.temp.value",
      "valueType": "number",
      "unit": { "path": "zone.temp.unit", "allowed": ["degC", "degF"] },
      "bounds": { "min": -60, "max": 80 }
    },
    {
      "signal": "relative_humidity",
      "path": "zone.rh.value",
      "valueType": "number",
      "unit": { "path": "zone.rh.unit", "allowed": ["%", "fraction"] },
      "bounds": { "min": 0, "max": 100 }
    },
    {
      "signal": "equipment_running",
      "asset": { "fixed": "AST-SIM-FAN-B" },
      "path": "backup.status",
      "valueType": "boolean",
      "enum": { "RUN": true, "STOP": false },
      "note": "Backup cooling unit run state."
    }
  ]
}
