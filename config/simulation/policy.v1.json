{
  "schema": "simulation-policy.v1",
  "label": "DEMO / SIMULATION POLICY",
  "note": "These are demonstration settings for the Facility Simulation. They are not the production or insurer policy, which lives in config/ and is not changed here. Every change creates a new immutable version; cases keep the version they were judged under.",
  "parameters": [
    {
      "id": "rule.vibrationZ",
      "group": "Detection rule",
      "label": "Vibration deviation",
      "description": "How far vibration must be above its learned baseline, in standard deviations.",
      "target": "rule",
      "path": "thresholds.vibrationZ",
      "unit": "standard deviations",
      "operator": ">=",
      "role": "REQUIRED",
      "min": 1,
      "max": 6,
      "step": 0.1,
      "default": 2,
      "integer": false,
      "signal": "vibration_rms"
    },
    {
      "id": "rule.currentDeviationPercent",
      "group": "Detection rule",
      "label": "Current deviation",
      "description": "How far equipment current must be above its learned baseline.",
      "target": "rule",
      "path": "thresholds.currentDeviationPercent",
      "unit": "%",
      "operator": ">= +",
      "role": "REQUIRED",
      "min": 3,
      "max": 30,
      "step": 0.5,
      "default": 8,
      "integer": false,
      "signal": "current"
    },
    {
      "id": "rule.outdoorTemperatureDegF",
      "group": "Detection rule",
      "label": "Outdoor heat limit",
      "description": "Outdoor temperature that counts as a heat context. Either this or a rising zone temperature is needed.",
      "target": "rule",
      "path": "thresholds.outdoorTemperatureDegF",
      "unit": "degF",
      "operator": ">=",
      "role": "SUPPORTING (either context)",
      "min": 80,
      "max": 125,
      "step": 1,
      "default": 105,
      "integer": false,
      "signal": "outdoor_temperature"
    },
    {
      "id": "rule.zoneSlopeDegCPerHour",
      "group": "Detection rule",
      "label": "Rising zone temperature",
      "description": "Zone temperature slope that counts as rising. The alternative heat context.",
      "target": "rule",
      "path": "thresholds.zoneTemperatureSlopeDegCPerHour",
      "unit": "degC per hour",
      "operator": ">",
      "role": "SUPPORTING (either context)",
      "min": -2,
      "max": 5,
      "step": 0.1,
      "default": 0,
      "integer": false,
      "signal": "temperature"
    },
    {
      "id": "rule.persistence",
      "group": "Detection rule",
      "label": "Persistence",
      "description": "How many consecutive qualifying checks are needed before a risk is detected.",
      "target": "rule",
      "path": "persistence.minQualifyingEvaluations",
      "unit": "checks",
      "operator": ">=",
      "role": "REQUIRED",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3,
      "integer": true
    },
    {
      "id": "rule.maxGapSeconds",
      "group": "Detection rule",
      "label": "Persistence gap",
      "description": "A longer gap between qualifying checks restarts the count.",
      "target": "rule",
      "path": "persistence.maxGapSeconds",
      "unit": "seconds",
      "operator": "<=",
      "role": "REQUIRED",
      "min": 10,
      "max": 120,
      "step": 5,
      "default": 30,
      "integer": false
    },
    {
      "id": "rule.contextMaxAgeSeconds",
      "group": "Detection rule",
      "label": "Context freshness",
      "description": "How old a weather or context reading may be and still count.",
      "target": "rule",
      "path": "contextMaxAgeSeconds",
      "unit": "seconds",
      "operator": "<=",
      "role": "REQUIRED",
      "min": 60,
      "max": 7200,
      "step": 60,
      "default": 2700,
      "integer": false
    },
    {
      "id": "baseline.warmUpSeconds",
      "group": "Baseline learning",
      "label": "Baseline learning window",
      "description": "How long the system learns what normal looks like.",
      "target": "baseline",
      "path": "warmUpSeconds",
      "unit": "seconds",
      "operator": ">=",
      "role": "REQUIRED",
      "min": 30,
      "max": 600,
      "step": 10,
      "default": 60,
      "integer": false
    },
    {
      "id": "baseline.minObservations",
      "group": "Baseline learning",
      "label": "Baseline minimum samples",
      "description": "Samples needed before a baseline is READY.",
      "target": "baseline",
      "path": "minObservations",
      "unit": "samples",
      "operator": ">=",
      "role": "REQUIRED",
      "min": 4,
      "max": 60,
      "step": 1,
      "default": 8,
      "integer": true
    },
    {
      "id": "dataQuality.staleAfterSeconds",
      "group": "Data quality",
      "label": "Reading freshness",
      "description": "A reading older than this is stale and untrusted.",
      "target": "dataQuality",
      "path": "staleAfterSeconds",
      "unit": "seconds",
      "operator": "<=",
      "role": "REQUIRED",
      "min": 30,
      "max": 600,
      "step": 10,
      "default": 120,
      "integer": false
    },
    {
      "id": "dataQuality.outdoorStaleAfterSeconds",
      "group": "Data quality",
      "label": "Outdoor weather freshness",
      "description": "Slow external context stays fresh longer than sensor readings.",
      "target": "dataQuality",
      "path": "staleAfterSecondsBySignal.outdoor_temperature",
      "unit": "seconds",
      "operator": "<=",
      "role": "SUPPORTING",
      "min": 300,
      "max": 10800,
      "step": 60,
      "default": 3600,
      "integer": false,
      "signal": "outdoor_temperature"
    },
    {
      "id": "verification.postActionWindowSeconds",
      "group": "Verification",
      "label": "Post-action window",
      "description": "How long after a reported action sensors are watched before a conclusion.",
      "target": "verification",
      "path": "postActionWindow.durationSeconds",
      "unit": "seconds",
      "operator": "=",
      "role": "REQUIRED",
      "min": 30,
      "max": 600,
      "step": 10,
      "default": 60,
      "integer": false
    },
    {
      "id": "verification.minObservations",
      "group": "Verification",
      "label": "Minimum observations",
      "description": "Trusted samples needed in the window.",
      "target": "verification",
      "path": "minObservations",
      "unit": "samples",
      "operator": ">=",
      "role": "REQUIRED",
      "min": 4,
      "max": 60,
      "step": 1,
      "default": 8,
      "integer": true
    },
    {
      "id": "verification.sustainedSeconds",
      "group": "Verification",
      "label": "Sustained interval",
      "description": "The condition must hold over this trailing interval.",
      "target": "verification",
      "path": "sustained.seconds",
      "unit": "seconds",
      "operator": ">=",
      "role": "REQUIRED",
      "min": 10,
      "max": 300,
      "step": 5,
      "default": 30,
      "integer": false
    },
    {
      "id": "verification.sustainedMinObservations",
      "group": "Verification",
      "label": "Sustained minimum samples",
      "description": "Samples needed inside the sustained interval.",
      "target": "verification",
      "path": "sustained.minObservations",
      "unit": "samples",
      "operator": ">=",
      "role": "REQUIRED",
      "min": 3,
      "max": 40,
      "step": 1,
      "default": 5,
      "integer": true
    },
    {
      "id": "verification.vibrationTargetMaxZ",
      "group": "Verification",
      "label": "Vibration target",
      "description": "Vibration must return to at most this deviation from baseline.",
      "target": "verification",
      "path": "criteria.vibration.targetMax",
      "unit": "standard deviations",
      "operator": "<=",
      "role": "REQUIRED",
      "min": 0.5,
      "max": 1.9,
      "step": 0.1,
      "default": 1,
      "integer": false,
      "signal": "vibration_rms"
    },
    {
      "id": "verification.currentTargetMaxPercent",
      "group": "Verification",
      "label": "Current target",
      "description": "Current must return to within this deviation of baseline.",
      "target": "verification",
      "path": "criteria.current.targetMax",
      "unit": "%",
      "operator": "<=",
      "role": "REQUIRED",
      "min": 1,
      "max": 7,
      "step": 0.5,
      "default": 3,
      "integer": false,
      "signal": "current"
    },
    {
      "id": "verification.recurrenceWatchSeconds",
      "group": "Verification",
      "label": "Recurrence watch",
      "description": "How long a verified improvement is watched for the hazard returning.",
      "target": "verification",
      "path": "recurrenceWatch.seconds",
      "unit": "seconds",
      "operator": "=",
      "role": "REQUIRED",
      "min": 60,
      "max": 86400,
      "step": 60,
      "default": 3600,
      "integer": false
    },
    {
      "id": "escalation.ack.LOW",
      "group": "Escalation (unacknowledged alerts)",
      "label": "Acknowledgement deadline - low",
      "description": "Seconds before an unacknowledged alert escalates to the organization administrator.",
      "target": "escalation",
      "path": "acknowledgementDeadlineSeconds.LOW",
      "unit": "seconds",
      "operator": "<=",
      "role": "REQUIRED",
      "min": 60,
      "max": 7200,
      "step": 30,
      "default": 1800,
      "integer": false
    },
    {
      "id": "escalation.ack.MODERATE",
      "group": "Escalation (unacknowledged alerts)",
      "label": "Acknowledgement deadline - moderate",
      "description": "Seconds before an unacknowledged alert escalates to the organization administrator.",
      "target": "escalation",
      "path": "acknowledgementDeadlineSeconds.MODERATE",
      "unit": "seconds",
      "operator": "<=",
      "role": "REQUIRED",
      "min": 60,
      "max": 7200,
      "step": 30,
      "default": 600,
      "integer": false
    },
    {
      "id": "escalation.ack.HIGH",
      "group": "Escalation (unacknowledged alerts)",
      "label": "Acknowledgement deadline - high",
      "description": "Seconds before an unacknowledged alert escalates to the organization administrator.",
      "target": "escalation",
      "path": "acknowledgementDeadlineSeconds.HIGH",
      "unit": "seconds",
      "operator": "<=",
      "role": "REQUIRED",
      "min": 60,
      "max": 7200,
      "step": 30,
      "default": 420,
      "integer": false
    },
    {
      "id": "escalation.ack.CRITICAL",
      "group": "Escalation (unacknowledged alerts)",
      "label": "Acknowledgement deadline - critical",
      "description": "Seconds before an unacknowledged alert escalates to the organization administrator.",
      "target": "escalation",
      "path": "acknowledgementDeadlineSeconds.CRITICAL",
      "unit": "seconds",
      "operator": "<=",
      "role": "REQUIRED",
      "min": 60,
      "max": 7200,
      "step": 30,
      "default": 300,
      "integer": false
    },
    {
      "id": "followUp.notImprovingCooldownSeconds",
      "group": "Follow-up notifications",
      "label": "Follow-up cooldown (not improving)",
      "description": "Minimum time between follow-ups for the same case and trigger.",
      "target": "followUp",
      "path": "triggers.VERIFICATION_NOT_IMPROVING.cooldownSeconds",
      "unit": "seconds",
      "operator": ">=",
      "role": "REQUIRED",
      "min": 0,
      "max": 3600,
      "step": 30,
      "default": 120,
      "integer": false
    },
    {
      "id": "followUp.overdueAfterSeconds",
      "group": "Follow-up notifications",
      "label": "Action overdue after",
      "description": "An assigned action not reported after this long triggers a follow-up.",
      "target": "followUp",
      "path": "triggers.ACTION_OVERDUE.overdueAfterSeconds",
      "unit": "seconds",
      "operator": ">=",
      "role": "REQUIRED",
      "min": 30,
      "max": 86400,
      "step": 30,
      "default": 600,
      "integer": false
    },
    {
      "id": "followUp.maxPerRiskEvent",
      "group": "Follow-up notifications",
      "label": "Follow-ups per risk event",
      "description": "Cap on follow-ups, so people are not spammed.",
      "target": "followUp",
      "path": "maxFollowUpsPerRiskEvent",
      "unit": "follow-ups",
      "operator": "<=",
      "role": "REQUIRED",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 5,
      "integer": true
    }
  ]
}
