# Production image for the Next.js web app (S9). Public Firebase web config is passed as build
# args (it is not a secret); the API URL and auth mode are runtime environment variables.
FROM node:22-slim AS build
WORKDIR /repo
RUN npm install -g pnpm@12.8.1
COPY . .
RUN pnpm install --frozen-lockfile
ARG NEXT_PUBLIC_FIREBASE_API_KEY
ARG NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN
ARG NEXT_PUBLIC_FIREBASE_PROJECT_ID
ARG NEXT_PUBLIC_FIREBASE_APP_ID
ENV NEXT_PUBLIC_FIREBASE_API_KEY=${NEXT_PUBLIC_FIREBASE_API_KEY} \
    NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=${NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN} \
    NEXT_PUBLIC_FIREBASE_PROJECT_ID=${NEXT_PUBLIC_FIREBASE_PROJECT_ID} \
    NEXT_PUBLIC_FIREBASE_APP_ID=${NEXT_PUBLIC_FIREBASE_APP_ID} \
    NEXT_TELEMETRY_DISABLED=1
RUN pnpm --dir apps/web build

FROM gcr.io/distroless/nodejs22-debian12:nonroot
WORKDIR /app
ARG GIT_SHA=unknown
COPY --from=build /repo/apps/web/.next/standalone ./
COPY --from=build /repo/apps/web/.next/static ./apps/web/.next/static
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=8080 \
    SYMBIOSIS_AUTH_MODE=token \
    SYMBIOSIS_VERSION=${GIT_SHA}
EXPOSE 8080
CMD ["apps/web/server.js"]
